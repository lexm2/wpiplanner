<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" xmlns:c="urn:import:edu.wpi.scheduler.client.courseselection">

	<ui:style>
		.pretty {	
		    font-weight: bold;
		    margin-bottom: 5px;
		    padding: 3px;
		    text-align: center;
		    background-color: lightgrey;
		}
		
		.searchPanel {
		    padding: 8px;
		    background-color: #f0f0f0;
		    border-bottom: 1px solid #ccc;
		}
		
		.searchBox {
		    width: 200px;
		    padding: 4px;
		    border: 1px solid #ccc;
		    border-radius: 3px;
		}
		
		.checkboxPanel {
		    margin-top: 5px;
		    font-size: 12px;
		}
	</ui:style>

	<g:SplitLayoutPanel>
		<g:west size="250">
			<c:DepartmentListBox ui:field="departmentList" />
		</g:west>

		<g:east size='250'>
			<g:SplitLayoutPanel>
				<g:center>
					<c:CourseDescriptionInfo ui:field="courseDescription" />
				</g:center>
				<g:south size="250">
					<g:ScrollPanel>
						<g:FlowPanel>
							<g:HTMLPanel styleName='{style.pretty}'>Courses</g:HTMLPanel>
							<c:CourseSelection ui:field="courseSelection" />
						</g:FlowPanel>
					</g:ScrollPanel>
				</g:south>
			</g:SplitLayoutPanel>
		</g:east>

		<g:center>
			<g:VerticalPanel width="100%" height="100%">
				<g:cell height="60px">
					<g:VerticalPanel styleName="{style.searchPanel}" width="100%">
						<g:HorizontalPanel>
							<g:HTML>Search:&nbsp;</g:HTML>
							<g:TextBox ui:field="searchBox" styleName="{style.searchBox}" />
						</g:HorizontalPanel>
						<g:HorizontalPanel styleName="{style.checkboxPanel}">
							<g:CheckBox ui:field="selectedDepartmentsOnly" text="Filter by selected departments only" />
						</g:HorizontalPanel>
					</g:VerticalPanel>
				</g:cell>
				<g:cell>
					<g:ScrollPanel width="100%" height="100%">
						<c:CourseList ui:field="courseList" />
					</g:ScrollPanel>
				</g:cell>
			</g:VerticalPanel>
		</g:center>

	</g:SplitLayoutPanel>


</ui:UiBinder>
