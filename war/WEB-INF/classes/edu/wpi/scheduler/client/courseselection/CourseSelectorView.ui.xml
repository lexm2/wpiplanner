<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" xmlns:c="urn:import:edu.wpi.scheduler.client.courseselection">


	<g:SplitLayoutPanel>
		<g:west size="250">
			<c:DepartmentListBox ui:field="departmentList" />
		</g:west>

		<g:east size='250'>
			<g:SplitLayoutPanel>
				<g:center>
					<c:CourseDescriptionInfo ui:field="courseDescription" />
				</g:center>
				<g:south size="250">
					<g:ScrollPanel>
						<g:FlowPanel>
							<g:HTMLPanel styleName='courseSelector-pretty'>Courses</g:HTMLPanel>
							<c:CourseSelection ui:field="courseSelection" />
						</g:FlowPanel>
					</g:ScrollPanel>
				</g:south>
			</g:SplitLayoutPanel>
		</g:east>

		<g:center>
			<g:HTMLPanel styleName="courseListParent">
				<div style="flex-shrink: 0;">
					<g:VerticalPanel styleName="courseSelector-searchPanel" width="100%">
						<g:HorizontalPanel>
							<g:HTML>Search:&nbsp;</g:HTML>
							<g:TextBox ui:field="searchBox" styleName="courseSelector-searchBox" />
						</g:HorizontalPanel>
						<g:HorizontalPanel styleName="courseSelector-checkboxPanel">
							<g:CheckBox ui:field="selectedDepartmentsOnly" text="Filter by selected departments only" />
						</g:HorizontalPanel>
					</g:VerticalPanel>
				</div>
				<g:ScrollPanel styleName="courseListContainer">
					<g:VerticalPanel width="100%">
						<c:CourseList ui:field="courseList" />
						<g:Button ui:field="loadMoreButton" styleName="courseSelector-loadMoreButton" text="Load More" visible="false" />
					</g:VerticalPanel>
				</g:ScrollPanel>
			</g:HTMLPanel>
		</g:center>

	</g:SplitLayoutPanel>


</ui:UiBinder>
