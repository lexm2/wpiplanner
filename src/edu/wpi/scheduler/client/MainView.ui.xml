<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" xmlns:s="urn:import:edu.wpi.scheduler.client.tabs">
	<ui:with field='res' type='edu.wpi.scheduler.client.Resources' />

	<g:DockLayoutPanel ui:field="layoutPanel">
		<g:north size="70">
			<g:DockLayoutPanel styleName='mainView-topBar'>
				<g:west size="185">
					<g:DockLayoutPanel styleName='mainView-topBarNoBottom'>
						<g:north size="40">
							<g:Label styleName='mainView-headerTitle'>Planner</g:Label>
						</g:north>
						<g:north size="20">
							<g:Label ui:field='yearLabel' styleName='mainView-headerSubTitle'></g:Label>
						</g:north>
					</g:DockLayoutPanel>
				</g:west>
				<g:west size="380">
					<g:VerticalPanel styleName='mainView-infoPanel' width="100%" height="100%">
						<g:Label styleName='mainView-authorLabel'></g:Label>
						<g:Label styleName='mainView-authorLabel'></g:Label>
						<g:InlineHTML ui:field='oldSchedLink' styleName='mainView-updatedTimestamp'></g:InlineHTML>
						<g:HorizontalPanel>
							<g:Label ui:field='updatedLabel' styleName='mainView-updatedTimestamp'></g:Label>
							<g:Button ui:field='refreshButton' text='Refresh' styleName='mainView-refreshButton' title='Refresh schedule data (updated every 15 minutes)'></g:Button>
						</g:HorizontalPanel>
					</g:VerticalPanel>
				</g:west>
				<g:center>
					<g:SimplePanel styleName='mainView-tabContainer'>
						<s:TabList styleName='mainView-rightTabs' ui:field="tabList" />
					</g:SimplePanel>
				</g:center>
			</g:DockLayoutPanel>
		</g:north>
		<g:center>
			<g:SimplePanel ui:field="bodyPanel"/>
		</g:center> 

	</g:DockLayoutPanel>
</ui:UiBinder> 